# Creator Office AI — configuration.
#
# Copy this file to `.env` (next to this one) and fill in what you have.
# Everything is optional in development: whatever is missing leaves the
# matching feature in "Pendiente de conexión" instead of faking it.
# An empty value means "not set". Variables in the environment win over this file.
# Never commit your `.env`.

# --- Application ---------------------------------------------------------------
# "production" switches off the API docs and refuses to start without APP_SECRET_KEY.
APP_ENV=development
# Public address of this server. It is used to build the OAuth redirect URIs
# ({APP_BASE_URL}/api/integrations/{youtube|tiktok|instagram}/callback) and the
# links Instagram downloads videos from, so it must be the address people really use.
APP_BASE_URL=http://localhost:8000
# Where the database, the uploaded files and the generated key live.
# Default: apps/creator-office/data
#DATA_DIR=
# Default: a SQLite file inside DATA_DIR. Any SQLAlchemy URL works.
#DATABASE_URL=
# Encrypts stored tokens and API keys and signs private file links. Required in production.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In development, if it is empty, a key is generated at DATA_DIR/secret.key.
APP_SECRET_KEY=
# false = new accounts only with an invitation link.
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=2048
# Jobs (agent steps, exports, uploads to platforms) that may run at the same time.
WORKER_CONCURRENCY=3
# Where the built frontend is. Default: apps/creator-office/frontend/dist
#FRONTEND_DIST=

# --- Server (used by the `creator-office` command) -----------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Session cookie ------------------------------------------------------------
SESSION_TTL_HOURS=336
# lax | strict | none. "none" is only for running the app inside an iframe of
# another site; it forces the Secure flag.
SESSION_COOKIE_SAMESITE=lax
# auto = Secure when the request arrived over https.
SESSION_COOKIE_SECURE=auto
SESSION_COOKIE_PARTITIONED=false
# Who may show the app inside a frame (Content-Security-Policy frame-ancestors):
# self, none, or the origins allowed, separated by spaces (https://intranet.example).
# Keep self unless you embed the app in another site.
ALLOWED_FRAME_ANCESTORS=self

# --- AI provider (optional) ----------------------------------------------------
# Without a model the agents run on the built-in demo engine: they use their real
# tools and leave [bracketed] gaps where a model would write. No tokens, no cost.
# A workspace owner can also set a provider from Integraciones; that one wins.
# Format: provider/model, as CrewAI expects. Examples:
#   openai/gpt-4o-mini   anthropic/claude-sonnet-4-5   gemini/gemini-2.5-flash   ollama/llama3.1
LLM_MODEL=
LLM_API_KEY=
# Only for self-hosted or OpenAI-compatible endpoints (Ollama: http://localhost:11434).
LLM_BASE_URL=
# Optional, in USD per million tokens. Without them the cost is shown as "sin estimar".
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# --- Transcription (optional) --------------------------------------------------
# Any OpenAI-compatible /audio/transcriptions endpoint. Without it, upload an
# .srt or .vtt file, or let Clipper work from audio and picture signals only.
# The model must answer with timed segments (response_format=verbose_json), as
# whisper-1 does. Both values are needed; LLM_API_KEY is never sent to this
# service. A self-hosted server that asks for no key still needs some value here.
TRANSCRIPTION_MODEL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1

# --- Media ---------------------------------------------------------------------
# Path to an ffmpeg binary. Not needed if ffmpeg is on PATH or the "media" extra
# (imageio-ffmpeg) is installed.
FFMPEG_PATH=

# --- Platform apps -------------------------------------------------------------
# OAuth clients that you register in each platform's developer console. Each
# person then connects their own account from Integraciones. While a pair is
# empty, that platform shows "Pendiente de conexión" and offers manual export.

# YouTube Data API v3 + YouTube Analytics API (Google Cloud console, OAuth client "Web").
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok for Developers: Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram API with Instagram Login (Meta for Developers). Publishing also needs
# APP_BASE_URL to be a public https address, because Instagram downloads the video.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v21.0
